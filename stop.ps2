#!/usr/bin/env bash
# Stop script #2 - for Ubuntu (and other Debian-based Linux) users.
# Stops OverFlowEngine's backend and frontend dev servers by freeing
# ports 8000 and 5173, so a leftover uvicorn --reload / vite process
# doesn't hold the port next time you start.

set -uo pipefail

step() { printf '\033[36m==> %s\033[0m\n' "$1"; }
ok()   { printf '\033[32m    OK: %s\033[0m\n' "$1"; }
warn() { printf '\033[33m    WARN: %s\033[0m\n' "$1"; }
err()  { printf '\033[31m    ERROR: %s\033[0m\n' "$1"; }

if ! command -v lsof >/dev/null 2>&1; then
  err "lsof not found - install it with: sudo apt install lsof"
  exit 1
fi

stop_port() {
  local port="$1" label="$2" pids
  pids="$(lsof -ti tcp:"$port" 2>/dev/null || true)"
  if [ -z "$pids" ]; then
    ok "$label (port $port) is not running"
    return
  fi
  warn "Stopping $label - PID(s): $pids"
  kill -9 $pids 2>/dev/null || true
  ok "$label (port $port) stopped"
}

step "Stopping OverFlowEngine dev servers"
stop_port 8000 "Backend"
stop_port 5173 "Frontend"

echo ""
echo "Postgres/Redis are still running in Docker. Run 'docker compose down' if you want to stop those too."
