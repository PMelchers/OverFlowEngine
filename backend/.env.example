DATABASE_URL=postgresql+psycopg://overflow:overflow@localhost:5432/overflow
REDIS_URL=redis://localhost:6379/0
# Used to sign login tokens - change this to a random string for any real deployment.
SECRET_KEY=dev-insecure-secret-change-me

# Used to build OAuth redirect URIs - change these for any real deployment.
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# No Google/Microsoft Calendar credentials go here - there's no shared server-wide
# OAuth app. Each user registers their own OAuth app and pastes its client id/secret
# into Settings -> Calendars in the app itself. See RUNNING.md for the steps.
